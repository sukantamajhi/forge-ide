{
  "fn": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2}) ${3:-> ${4:()} }{",
      "\t$0",
      "}"
    ],
    "description": "A function"
  },
  "pub fn": {
    "prefix": "pfn",
    "body": [
      "pub fn ${1:name}(${2}) ${3:-> ${4:()} }{",
      "\t$0",
      "}"
    ],
    "description": "A public function"
  },
  "async fn": {
    "prefix": "afn",
    "body": [
      "async fn ${1:name}(${2}) ${3:-> ${4:()} }{",
      "\t$0",
      "}"
    ],
    "description": "An async function"
  },
  "main": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "\t$0",
      "}"
    ],
    "description": "The main function"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "#[derive(Debug, Clone)]",
      "struct ${1:Name} {",
      "\t${2:field}: ${3:Type},",
      "}"
    ],
    "description": "A struct with derives"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "#[derive(Debug, Clone, PartialEq)]",
      "enum ${1:Name} {",
      "\t${2:Variant},",
      "}"
    ],
    "description": "An enum"
  },
  "impl": {
    "prefix": "impl",
    "body": [
      "impl ${1:Type} {",
      "\t$0",
      "}"
    ],
    "description": "An impl block"
  },
  "impl trait": {
    "prefix": "implt",
    "body": [
      "impl ${1:Trait} for ${2:Type} {",
      "\t$0",
      "}"
    ],
    "description": "A trait impl"
  },
  "trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "A trait"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:pattern} => ${3:expr},",
      "\t_ => $0,",
      "}"
    ],
    "description": "A match expression"
  },
  "if let": {
    "prefix": "iflet",
    "body": [
      "if let ${1:Some(x)} = ${2:value} {",
      "\t$0",
      "}"
    ],
    "description": "if let"
  },
  "while let": {
    "prefix": "whilelet",
    "body": [
      "while let ${1:Some(x)} = ${2:iter.next()} {",
      "\t$0",
      "}"
    ],
    "description": "while let"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:iter} {",
      "\t$0",
      "}"
    ],
    "description": "A for loop"
  },
  "loop": {
    "prefix": "loop",
    "body": [
      "loop {",
      "\t$0",
      "}"
    ],
    "description": "An endless loop"
  },
  "println!": {
    "prefix": "println",
    "body": [
      "println!(\"${1:{}}\"${2:, $3});"
    ],
    "description": "Print a line"
  },
  "eprintln!": {
    "prefix": "eprintln",
    "body": [
      "eprintln!(\"${1:{}}\"${2:, $3});"
    ],
    "description": "Print an error line"
  },
  "format!": {
    "prefix": "format",
    "body": [
      "format!(\"${1:{}}\"${2:, $3})"
    ],
    "description": "format!"
  },
  "vec!": {
    "prefix": "vec",
    "body": [
      "vec![${1}]"
    ],
    "description": "A vec"
  },
  "test": {
    "prefix": "test",
    "body": [
      "#[test]",
      "fn ${1:name}() {",
      "\t$0",
      "}"
    ],
    "description": "A unit test"
  },
  "test module": {
    "prefix": "testmod",
    "body": [
      "#[cfg(test)]",
      "mod tests {",
      "\tuse super::*;",
      "",
      "\t#[test]",
      "\tfn ${1:name}() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "A test module"
  },
  "mod": {
    "prefix": "mod",
    "body": [
      "mod ${1:name} {",
      "\t$0",
      "}"
    ],
    "description": "A module"
  },
  "derive": {
    "prefix": "derive",
    "body": [
      "#[derive(${1:Debug, Clone})]"
    ],
    "description": "A derive attribute"
  },
  "Result alias": {
    "prefix": "result",
    "body": [
      "Result<${1:()}, ${2:Box<dyn std::error::Error>}>"
    ],
    "description": "A Result type"
  },
  "closure": {
    "prefix": "closure",
    "body": [
      "|${1:x}| ${2:expr}"
    ],
    "description": "A closure"
  },
  "assert_eq!": {
    "prefix": "asserteq",
    "body": [
      "assert_eq!(${1:left}, ${2:right});"
    ],
    "description": "assert_eq!"
  },
  "unimplemented": {
    "prefix": "todo!",
    "body": [
      "todo!(\"${1:later}\")"
    ],
    "description": "todo!"
  }
}
