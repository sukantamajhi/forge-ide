{
  "function": {
    "prefix": "fn",
    "body": [
      "function ${1:name}(${2})",
      "\t$0",
      "end"
    ],
    "description": "A function"
  },
  "local function": {
    "prefix": "lfn",
    "body": [
      "local function ${1:name}(${2})",
      "\t$0",
      "end"
    ],
    "description": "A local function"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:i} = ${2:1}, ${3:10} do",
      "\t$0",
      "end"
    ],
    "description": "A numeric for"
  },
  "for pairs": {
    "prefix": "forp",
    "body": [
      "for ${1:k}, ${2:v} in pairs(${3:t}) do",
      "\t$0",
      "end"
    ],
    "description": "for pairs"
  },
  "for ipairs": {
    "prefix": "fori",
    "body": [
      "for ${1:i}, ${2:v} in ipairs(${3:t}) do",
      "\t$0",
      "end"
    ],
    "description": "for ipairs"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:condition} then",
      "\t$0",
      "end"
    ],
    "description": "if"
  },
  "local": {
    "prefix": "local",
    "body": [
      "local ${1:name} = ${2:value}"
    ],
    "description": "A local"
  },
  "require": {
    "prefix": "req",
    "body": [
      "local ${1:name} = require(\"${2:module}\")"
    ],
    "description": "require"
  },
  "module": {
    "prefix": "mod",
    "body": [
      "local M = {}",
      "",
      "$0",
      "",
      "return M"
    ],
    "description": "A module table"
  }
}
