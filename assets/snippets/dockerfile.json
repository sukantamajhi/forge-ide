{
  "Node app": {
    "prefix": "node",
    "body": [
      "FROM node:${1:20}-alpine",
      "WORKDIR /app",
      "COPY package*.json ./",
      "RUN npm ci --omit=dev",
      "COPY . .",
      "EXPOSE ${2:3000}",
      "CMD [\"node\", \"${3:index.js}\"]"
    ],
    "description": "A Node image"
  },
  "Python app": {
    "prefix": "python",
    "body": [
      "FROM python:${1:3.12}-slim",
      "WORKDIR /app",
      "COPY requirements.txt .",
      "RUN pip install --no-cache-dir -r requirements.txt",
      "COPY . .",
      "CMD [\"python\", \"${2:main.py}\"]"
    ],
    "description": "A Python image"
  },
  "Rust multi-stage": {
    "prefix": "rust",
    "body": [
      "FROM rust:${1:1}-slim AS build",
      "WORKDIR /src",
      "COPY . .",
      "RUN cargo build --release",
      "",
      "FROM debian:stable-slim",
      "COPY --from=build /src/target/release/${2:app} /usr/local/bin/${2:app}",
      "CMD [\"${2:app}\"]"
    ],
    "description": "A Rust multi-stage build"
  },
  "healthcheck": {
    "prefix": "health",
    "body": [
      "HEALTHCHECK --interval=30s --timeout=3s CMD ${1:curl -f http://localhost/ || exit 1}"
    ],
    "description": "A HEALTHCHECK"
  }
}
