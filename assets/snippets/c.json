{
  "main": {
    "prefix": "main",
    "body": [
      "#include <stdio.h>",
      "",
      "int main(int argc, char **argv) {",
      "\t$0",
      "\treturn 0;",
      "}"
    ],
    "description": "A main function"
  },
  "include": {
    "prefix": "inc",
    "body": [
      "#include <${1:stdio.h}>"
    ],
    "description": "#include <>"
  },
  "include local": {
    "prefix": "incl",
    "body": [
      "#include \"${1:file.h}\""
    ],
    "description": "#include \"\""
  },
  "header guard": {
    "prefix": "guard",
    "body": [
      "#ifndef ${1:${TM_FILENAME_BASE/(.*)/${1:/upcase}/}_H}",
      "#define ${1:${TM_FILENAME_BASE/(.*)/${1:/upcase}/}_H}",
      "",
      "$0",
      "",
      "#endif"
    ],
    "description": "A header guard"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++) {",
      "\t$0",
      "}"
    ],
    "description": "A for loop"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "A while loop"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "if"
  },
  "if else": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "if / else"
  },
  "switch": {
    "prefix": "switch",
    "body": [
      "switch (${1:value}) {",
      "case ${2:x}:",
      "\t$0",
      "\tbreak;",
      "default:",
      "\tbreak;",
      "}"
    ],
    "description": "switch"
  },
  "function": {
    "prefix": "func",
    "body": [
      "${1:int} ${2:name}(${3:void}) {",
      "\t$0",
      "}"
    ],
    "description": "A function"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "typedef struct {",
      "\t${2:int} ${3:field};",
      "} ${1:Name};"
    ],
    "description": "A typedef struct"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "typedef enum {",
      "\t${2:A},",
      "} ${1:Name};"
    ],
    "description": "A typedef enum"
  },
  "printf": {
    "prefix": "printf",
    "body": [
      "printf(\"${1:%d}\\n\", ${2:value});"
    ],
    "description": "printf"
  },
  "malloc": {
    "prefix": "malloc",
    "body": [
      "${1:int} *${2:p} = malloc(${3:n} * sizeof(*${2:p}));",
      "if (!${2:p}) {",
      "\t$0",
      "}"
    ],
    "description": "malloc with a check"
  }
}
