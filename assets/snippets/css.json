{
  "flex center": {
    "prefix": "flexcenter",
    "body": [
      "display: flex;",
      "align-items: center;",
      "justify-content: center;"
    ],
    "description": "Centre with flexbox"
  },
  "flex": {
    "prefix": "flex",
    "body": [
      "display: flex;",
      "flex-direction: ${1:row};",
      "gap: ${2:1rem};"
    ],
    "description": "A flex container"
  },
  "grid": {
    "prefix": "grid",
    "body": [
      "display: grid;",
      "grid-template-columns: repeat(${1:3}, 1fr);",
      "gap: ${2:1rem};"
    ],
    "description": "A grid container"
  },
  "media query": {
    "prefix": "media",
    "body": [
      "@media (max-width: ${1:768px}) {",
      "\t$0",
      "}"
    ],
    "description": "A media query"
  },
  "dark scheme": {
    "prefix": "dark",
    "body": [
      "@media (prefers-color-scheme: dark) {",
      "\t$0",
      "}"
    ],
    "description": "A dark-mode block"
  },
  "custom property": {
    "prefix": "var",
    "body": [
      "var(--${1:name})"
    ],
    "description": "Use a custom property"
  },
  "root variables": {
    "prefix": "root",
    "body": [
      ":root {",
      "\t--${1:name}: ${2:value};",
      "}"
    ],
    "description": "Root variables"
  },
  "keyframes": {
    "prefix": "keyframes",
    "body": [
      "@keyframes ${1:name} {",
      "\tfrom { $2 }",
      "\tto { $0 }",
      "}"
    ],
    "description": "Keyframes"
  },
  "transition": {
    "prefix": "transition",
    "body": [
      "transition: ${1:all} ${2:0.2s} ${3:ease};"
    ],
    "description": "A transition"
  },
  "absolute fill": {
    "prefix": "fill",
    "body": [
      "position: absolute;",
      "inset: 0;"
    ],
    "description": "Fill the parent"
  },
  "visually hidden": {
    "prefix": "sronly",
    "body": [
      "position: absolute;",
      "width: 1px;",
      "height: 1px;",
      "overflow: hidden;",
      "clip: rect(0 0 0 0);",
      "white-space: nowrap;"
    ],
    "description": "Screen-reader-only text"
  },
  "font face": {
    "prefix": "fontface",
    "body": [
      "@font-face {",
      "\tfont-family: \"${1:Name}\";",
      "\tsrc: url(\"${2:font.woff2}\") format(\"woff2\");",
      "\tfont-display: swap;",
      "}"
    ],
    "description": "A font-face rule"
  }
}
