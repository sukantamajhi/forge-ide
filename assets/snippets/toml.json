{
  "Cargo package": {
    "prefix": "cargo",
    "body": [
      "[package]",
      "name = \"${1:name}\"",
      "version = \"${2:0.1.0}\"",
      "edition = \"2021\"",
      "",
      "[dependencies]",
      "$0"
    ],
    "description": "A Cargo.toml"
  },
  "dependency": {
    "prefix": "dep",
    "body": [
      "${1:name} = \"${2:1}\""
    ],
    "description": "A dependency line"
  },
  "dependency with features": {
    "prefix": "depf",
    "body": [
      "${1:name} = { version = \"${2:1}\", features = [\"${3:feature}\"] }"
    ],
    "description": "A dependency with features"
  },
  "pyproject": {
    "prefix": "pyproject",
    "body": [
      "[project]",
      "name = \"${1:name}\"",
      "version = \"${2:0.1.0}\"",
      "requires-python = \">=${3:3.10}\"",
      "dependencies = [",
      "\t$0",
      "]"
    ],
    "description": "A pyproject.toml"
  }
}
