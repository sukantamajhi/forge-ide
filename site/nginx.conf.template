server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_vary on;
    gzip_types text/css text/plain application/javascript image/svg+xml font/ttf application/json application/xml;

    error_page 404 /404.html;
    location = /404.html {
        internal;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # nginx drops server-level headers in a location that sets its own, so each one includes the shared set.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        # Always revalidate HTML via ETag; browsers re-download only when the file changes.
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    location ~ ^/(robots\.txt|sitemap\.xml)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # Fonts: immutable — filenames are stable and files never change.
    location /assets/fonts/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # CSS, JS, WebP images, SVG and ICO: 1 year immutable.
    # These files are small enough that a 1-year cache is safe — bump the
    # filename (e.g. style.v2.css) whenever content changes.
    location ~* \.(?:css|js|webp|svg|ico)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ =404;
    }
}
