# Forge landing page: static files served by nginx, as a non-root user.
#
# Built from the repository root (Railway does this by itself, see railway.toml):
#   docker build -f Dockerfile.site -t forge-site .
#   docker run --rm -p 8080:8080 forge-site          # http://localhost:8080
#
# Environment:
#   PORT      port nginx listens on (Railway sets it; default 8080)
#   SITE_URL  public address, https://your-domain, for canonical links, social image and sitemap.
#             On Railway the generated domain (RAILWAY_PUBLIC_DOMAIN) is used when this is not set.

FROM nginxinc/nginx-unprivileged:1.27-alpine

# nginx fills ${PORT} into the config at start-up (only PORT, so nginx's own $variables are left alone).
ENV PORT=8080 \
    NGINX_ENVSUBST_FILTER=^PORT$
COPY site/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY site/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --chown=nginx:nginx --chmod=755 site/site-url.sh /docker-entrypoint.d/40-site-url.sh
COPY --chown=nginx:nginx site/index.html site/robots.txt site/sitemap.xml site/404.html /usr/share/nginx/html/
COPY site/css /usr/share/nginx/html/css
COPY site/js /usr/share/nginx/html/js
COPY site/assets /usr/share/nginx/html/assets

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s CMD wget -q -O /dev/null http://127.0.0.1:${PORT}/healthz || exit 1
