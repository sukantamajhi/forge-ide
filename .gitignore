# Generated by Cargo: contains compiled files, object files, and binaries
/target/
# Linux builds made from Windows through WSL2 (see the Makefile)
/target-linux/

# Remove Cargo.lock from gitignore if creating an executable application.
# Keep it in gitignore if you are building a library.
Cargo.lock

# Backup files generated by rustfmt when formatting code
**/*.rs.bk

# Large compiler crash logs (Internal Compiler Errors)
rustc-ice-*.txt

# Linux packages built by make package-linux / package-deb (they go on the GitHub release, not in git)
dist/*.tar.gz
dist/*.deb
dist/*.sha256
